{
  "uid": "order-api-red",
  "title": "order-api RED & Business",
  "tags": [
    "order-lab",
    "exp04"
  ],
  "timezone": "browser",
  "panels": [
    {
      "title": "QPS by route",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"order-lab\"}[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "title": "P99 latency by route",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(http_request_duration_seconds_bucket{namespace=\"order-lab\"}[1m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "title": "5xx error rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"order-lab\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_requests_total{namespace=\"order-lab\"}[1m])), 1)",
          "legendFormat": "5xx rate"
        }
      ]
    },
    {
      "title": "Business: orders created / rejected",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(orders_created_total[1m])",
          "legendFormat": "created/s"
        },
        {
          "expr": "rate(orders_rejected_out_of_stock_total[1m])",
          "legendFormat": "rejected/s"
        },
        {
          "expr": "rate(orders_replayed_total[1m])",
          "legendFormat": "replayed/s"
        }
      ]
    },
    {
      "title": "Pod CPU throttling",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_cfs_throttled_seconds_total{namespace=\"order-lab\",container=\"order-api\"}[1m])) / clamp_min(sum(rate(container_cpu_usage_seconds_total{namespace=\"order-lab\",container=\"order-api\"}[1m])), 1e-9)",
          "legendFormat": "throttle ratio"
        }
      ]
    },
    {
      "title": "Cache hit ratio by op (EXP-07)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total{namespace=\"order-lab\"}[1m])) / clamp_min(sum(rate(cache_hits_total{namespace=\"order-lab\"}[1m])) + sum(rate(cache_misses_total{namespace=\"order-lab\"}[1m])), 1e-9)",
          "legendFormat": "overall"
        },
        {
          "expr": "sum by (op) (rate(cache_hits_total{namespace=\"order-lab\"}[1m])) / clamp_min(sum by (op) (rate(cache_hits_total{namespace=\"order-lab\"}[1m])) + sum by (op) (rate(cache_misses_total{namespace=\"order-lab\"}[1m])), 1e-9)",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "title": "Cache ops & errors (EXP-07)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (op) (rate(cache_hits_total{namespace=\"order-lab\"}[1m]))",
          "legendFormat": "hits {{op}}"
        },
        {
          "expr": "sum by (op) (rate(cache_misses_total{namespace=\"order-lab\"}[1m]))",
          "legendFormat": "misses {{op}}"
        },
        {
          "expr": "sum by (op) (rate(cache_negative_hits_total{namespace=\"order-lab\"}[1m]))",
          "legendFormat": "neg {{op}}"
        },
        {
          "expr": "sum by (op) (rate(cache_errors_total{namespace=\"order-lab\"}[1m]))",
          "legendFormat": "errors {{op}}"
        }
      ]
    },
    {
      "title": "Cache invalidations (EXP-07)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(cache_invalidate_total{namespace=\"order-lab\"}[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "title": "DB reads: product/stock backfill source (EXP-07)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"order-lab\",route=~\"/api/products/.*\",status=\"200\"}[1m]))",
          "legendFormat": "product 2xx"
        },
        {
          "expr": "sum(rate(cache_misses_total{namespace=\"order-lab\",op=\"product\"}[1m]))",
          "legendFormat": "product backfill (miss)"
        },
        {
          "expr": "sum(rate(cache_misses_total{namespace=\"order-lab\",op=\"stock\"}[1m]))",
          "legendFormat": "stock backfill (miss)"
        }
      ]
    },
    {
      "title": "Backfill wanted vs executed (EXP-08)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum by (op) (rate(cache_backfill_wanted_total{namespace=\"order-lab\"}[1m]))",
          "legendFormat": "wanted {{op}}"
        },
        {
          "expr": "sum by (op) (rate(cache_backfill_executed_total{namespace=\"order-lab\"}[1m]))",
          "legendFormat": "executed {{op}}"
        }
      ]
    },
    {
      "title": "Backfill outcome stacked (EXP-08)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(cache_backfill_outcome_total{namespace=\"order-lab\"}[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "title": "Invalidate queue len (EXP-08)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "cache_invalidate_queue_len{namespace=\"order-lab\"}",
          "legendFormat": "queue len"
        }
      ]
    },
    {
      "title": "Stale entries (EXP-08)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "expr": "cache_stale_entries{namespace=\"order-lab\"}",
          "legendFormat": "entries"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 2
}
